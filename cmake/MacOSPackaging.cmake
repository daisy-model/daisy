set(CPACK_GENERATOR "ZIP")
set(DAISY_MACOS_PACKAGE_ARCHITECTURE "${CMAKE_SYSTEM_PROCESSOR}")
if(CMAKE_OSX_ARCHITECTURES)
  list(JOIN CMAKE_OSX_ARCHITECTURES "-" DAISY_MACOS_PACKAGE_ARCHITECTURE)
endif()
if (${BUILD_PYTHON})
  set(CPACK_PACKAGE_FILE_NAME "${CMAKE_PROJECT_NAME}-${CMAKE_PROJECT_VERSION}-${CMAKE_SYSTEM_NAME}-${DAISY_MACOS_PACKAGE_ARCHITECTURE}-python${DAISY_PYTHON_VERSION}")
else()
  set(CPACK_PACKAGE_FILE_NAME "${CMAKE_PROJECT_NAME}-${CMAKE_PROJECT_VERSION}-${CMAKE_SYSTEM_NAME}-${DAISY_MACOS_PACKAGE_ARCHITECTURE}-no-python")
endif()
set(DAISY_PACKAGE_FILE_NAME ${CPACK_PACKAGE_FILE_NAME})
